{
  "name": "luxurystay-hms-backend",
  "version": "1.0.0",
  "description": "Complete Node.js + Express + MongoDB backend for the LuxuryStay Hotel Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-syntax.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch --runInBand",
    "backup": "node scripts/run-backup.js",
    "repair-permissions": "node scripts/repair-permissions.js",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "hotel",
    "management",
    "express",
    "mongodb",
    "hms"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 60000,
    "maxWorkers": 1
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.3.2"
  }
}
